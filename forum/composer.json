{
    "name": "flarum/flarum",
    "description": "Delightfully simple forum software.",
    "type": "project",
    "keywords": [
        "forum",
        "discussion"
    ],
    "homepage": "https://flarum.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "Flarum",
            "email": "info@flarum.org",
            "homepage": "https://flarum.org/team"
        }
    ],
    "support": {
        "issues": "https://github.com/flarum/core/issues",
        "source": "https://github.com/flarum/flarum",
        "docs": "https://docs.flarum.org/"
    },
    "require": {
        "dz6g/casdoor-oauth": "@dev",
        "dz6g/fof-js-inject": "@dev",
        "flarum-lang/chinese-simplified": "2.x-dev",
        "flarum/approval": "*",
        "flarum/audit": "*",
        "flarum/bbcode": "*",
        "flarum/core": "^2.0.0-rc.5",
        "flarum/emoji": "*",
        "flarum/flags": "*",
        "flarum/gdpr": "*",
        "flarum/lang-english": "*",
        "flarum/likes": "*",
        "flarum/lock": "*",
        "flarum/markdown": "*",
        "flarum/mentions": "*",
        "flarum/messages": "*",
        "flarum/nicknames": "*",
        "flarum/realtime": "*",
        "flarum/statistics": "*",
        "flarum/sticky": "*",
        "flarum/subscriptions": "*",
        "flarum/suspend": "*",
        "flarum/tags": "*",
        "fof/oauth": "^2.0@beta",
        "local/flarum-zh-cn": "@dev"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "repositories": {
        "0": {
            "type": "path",
            "url": "extensions/*",
            "options": {
                "symlink": false
            }
        },
        "casdoor-oauth": {
            "type": "path",
            "url": "extensions/casdoor-oauth"
        }
    }
}
